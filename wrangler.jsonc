{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egopos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "egopos"
    }
  ],
  "vars": {
    "IGO_DEMO_MODE": "false",
    "NEXTAUTH_URL": "https://egopos.i-goto.workers.dev"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b8ec6fa6a71f44e5a40a6a108ffe6a85"
    }
  ]
}
