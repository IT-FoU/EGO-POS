# Local development / tests. Do not put Production credentials here.
DEV_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/igo_pos?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/igo_pos_test?schema=public"

# Production Worker uses Hyperdrive. DATABASE_URL in .env.local is deploy/read-only tooling only.
# npm run dev ignores Production DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/igo_pos?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"
IGO_DEFAULT_LOCALE="lo"
IGO_BASE_CURRENCY="LAK"
IGO_DEMO_MODE="false"

# Required only for an explicit Production Prisma migrate. Never used by npm run dev.
# EGO_ALLOW_PRODUCTION_MIGRATION="true"

# Server-only product image Storage. Never prefix with NEXT_PUBLIC_.
# SUPABASE_URL="https://PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""

