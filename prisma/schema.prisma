  yearlyPrice     Decimal  @default(0) @map("yearly_price") @db.Decimal(18, 2)
  maxProducts     Int?     @map("max_products")
  maxCashiers     Int?     @map("max_cashiers")
  maxBranches     Int?     @map("max_branches")
  maxReports      Int?     @map("max_reports")
  maxPromotions   Int?     @map("max_promotions")
