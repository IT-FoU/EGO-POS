generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  active
  suspended
  disabled
  deleted
}

enum UserStatus {
  active
  disabled
  deleted
}

enum WarehouseType {
  store
  stockroom
  distribution
  virtual
}

enum CurrencyCode {
  LAK
  THB
  USD
}

enum PaymentMethod {
  cash
  transfer
  qr
  visa
  mastercard
}

enum StockMovementType {
  purchase
  sale
  transfer_in
  transfer_out
  adjustment
  damaged
  expired
  lost
  return
}

enum StockTransferStatus {
  draft
  pending
  completed
  cancelled
}

enum PayableStatus {
  unpaid
  partial
  paid
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum BillingCycle {
  monthly
  yearly
}

enum CashTransactionType {
  cash_in
  cash_out
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
  expired
}

enum RoleTemplate {
  owner
  manager
  cashier
  custom
}

enum BackupType {
  cloud
  local
}

enum BackupStatus {
  success
  failed
}

enum LoginStatus {
  success
  failed
}

enum ProductStatus {
  active
  inactive
  draft
  deleted
}

enum ProductType {
  standard
  service
  bundle
}

enum StockDisplayMode {
  base_unit_only
  breakdown
}

enum UnitStatus {
  active
  inactive
}

enum UnitPricingMode {
  manual
  cost_plus_percent
  cost_plus_amount
}

enum SupplierStatus {
  active
  inactive
  deleted
}

enum CustomerStatus {
  active
  inactive
  deleted
}

enum PurchaseStatus {
  draft
  ordered
  partial
  received
  cancelled
}

enum ReceivingStatus {
  draft
  partial
  received
  cancelled
}

enum SaleStatus {
  held
  completed
  cancelled
  refunded
}

enum PromotionType {
  percentage
  fixed_amount
  buy_x_get_y
  combo_set
  member_discount
}

enum PromotionStatus {
  active
  inactive
  scheduled
  expired
}

enum LoyaltyPointType {
  earn
  redeem
  adjust
  expire
}

model Company {
  id                  String         @id @default(cuid())
  name                String
  storeCode           String         @unique @map("store_code")
  businessTemplateKey String         @map("business_template_key")
  ownerUserId         String?        @map("owner_user_id")
  planId         String?        @map("plan_id")
  status         CompanyStatus  @default(active)
  defaultLocale  String         @default("lo") @map("default_locale")
  baseCurrency   CurrencyCode   @default(LAK) @map("base_currency")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  owner          User?          @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  plan           Plan?          @relation(fields: [planId], references: [id])
  branches       Branch[]
  warehouses     Warehouse[]
  members        CompanyUser[]
  roles          Role[]
  products       Product[]
  categories     Category[]
  brands         Brand[]
  suppliers      Supplier[]
  inventoryLots  InventoryLot[]
  goodsReceipts  GoodsReceipt[]
  sales          Sale[]
  cashSessions   CashSession[]
  membershipLevels   MembershipLevel[]
  loyaltyPointLedger LoyaltyPointLedger[]
  customerPayments   CustomerPayment[]
  promotionUsages    PromotionUsage[]
  auditLogs      AuditLog[]
  platformAuditLogs PlatformAuditLog[]
  storeActivityLogs StoreActivityLog[]
  settings       CompanySetting?
  subscriptions  SaaSSubscription[]
  notifications  Notification[]
  approvals      Approval[]
  approvalRules  ApprovalRule[]
  backups        Backup[]
  qrPaymentBanks QrPaymentBank[]
  qrPaymentAccounts QrPaymentAccount[]

  @@map("companies")
}

model CompanySetting {
  id                       String       @id @default(cuid())
  companyId                String       @unique @map("company_id")
  profilePhone             String?      @map("profile_phone")
  profileEmail             String?      @map("profile_email")
  profileAddress           String?      @map("profile_address")
  taxNumber                String?      @map("tax_number")
  receiptHeader            String?      @map("receipt_header")
  receiptFooter            String?      @map("receipt_footer")
  receiptPrefix            String       @default("INV") @map("receipt_prefix")
  showLogoOnReceipt        Boolean      @default(true) @map("show_logo_on_receipt")
  showTaxOnReceipt         Boolean      @default(true) @map("show_tax_on_receipt")
  vatEnabled               Boolean      @default(false) @map("vat_enabled")
  vatRate                  Decimal      @default(0) @map("vat_rate") @db.Decimal(5, 2)
  taxInclusive             Boolean      @default(false) @map("tax_inclusive")
  baseCurrency             CurrencyCode @default(LAK) @map("base_currency")
  currencyDisplay          String       @default("LAK") @map("currency_display")
  decimalPlaces            Int          @default(0) @map("decimal_places")
  roundingMethod           String       @default("nearest") @map("rounding_method")
  loyaltyEnabled           Boolean      @default(true) @map("loyalty_enabled")
  loyaltySpendPerPointLak  Decimal      @default(10000) @map("loyalty_spend_per_point_lak") @db.Decimal(18, 2)
  loyaltyPointValueLak     Decimal      @default(1000) @map("loyalty_point_value_lak") @db.Decimal(18, 2)
  loyaltyMinRedeemPoints   Int          @default(1) @map("loyalty_min_redeem_points")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  company                  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model Branch {
  id           String      @id @default(cuid())
  companyId    String      @map("company_id")
  name         String
  phone        String?
  address      String?
  isMainBranch Boolean     @default(false) @map("is_main_branch")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses   Warehouse[]
  products     Product[]
  categories   Category[]
  suppliers    Supplier[]
  customers    Customer[]
  cashSessions CashSession[]
  sales        Sale[]
  devices      PosDevice[]
  qrPaymentAccounts QrPaymentAccount[]
  storeActivityLogs StoreActivityLog[]
  companyUsers CompanyUser[]

  @@index([companyId])
  @@map("branches")
}

model QrPaymentBank {
  id        String             @id @default(cuid())
  companyId String             @map("company_id")
  bankName  String             @map("bank_name")
  shortCode String?            @map("short_code")
  logoUrl   String?            @map("logo_url")
  sortOrder Int                @default(0) @map("sort_order")
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts  QrPaymentAccount[]

  @@unique([companyId, bankName])
  @@index([companyId, isActive])
  @@map("qr_payment_banks")
}

model QrPaymentAccount {
  id                    String        @id @default(cuid())
  companyId             String        @map("company_id")
  branchId              String        @map("branch_id")
  bankId                String        @map("bank_id")
  accountName           String        @map("account_name")
  accountNumber         String        @map("account_number")
  displayLabel          String?       @map("display_label")
  qrImageUrl            String?       @map("qr_image_url")
  isDefault             Boolean       @default(false) @map("is_default")
  printOnReceipt        Boolean       @default(true) @map("print_on_receipt")
  showOnCustomerDisplay Boolean       @default(true) @map("show_on_customer_display")
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  bank                  QrPaymentBank @relation(fields: [bankId], references: [id], onDelete: Restrict)
  branch                Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, bankId, accountNumber])
  @@index([companyId, branchId, isActive])
  @@map("qr_payment_accounts")
}

model Warehouse {
  id           String              @id @default(cuid())
  companyId    String              @map("company_id")
  branchId     String              @map("branch_id")
  name         String
  type         WarehouseType        @default(store)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  balances     InventoryBalance[]
  movements    StockMovement[]
  sourceStockMovements      StockMovement[] @relation("StockMovementSourceWarehouse")
  destinationStockMovements StockMovement[] @relation("StockMovementDestinationWarehouse")
  adjustments  StockAdjustment[]
  purchases    Purchase[]
  inventoryLots InventoryLot[]
  goodsReceipts GoodsReceipt[]
  sales        Sale[]
  fromTransfers StockTransfer[]     @relation("FromWarehouse")
  toTransfers   StockTransfer[]     @relation("ToWarehouse")

  @@index([companyId, branchId])
  @@map("warehouses")
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  email           String?       @unique
  phone           String?
  passwordHash    String        @map("password_hash")
  pinHash         String?       @map("pin_hash")
  fullName        String        @map("full_name")
  status          UserStatus    @default(active)
  preferredLocale String        @default("lo") @map("preferred_locale")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  ownedCompanies  Company[]     @relation("CompanyOwner")
  companies       CompanyUser[]
  roles           UserRole[]
  auditLogs       AuditLog[]
  storeActivityLogs StoreActivityLog[]
  loginHistory    LoginHistory[]
  favoriteProducts FavoriteProduct[]

  @@map("users")
}

model CompanyUser {
  id                    String     @id @default(cuid())
  companyId             String     @map("company_id")
  userId                String     @map("user_id")
  branchId              String?    @map("branch_id")
  isOwner               Boolean    @default(false) @map("is_owner")
  status                UserStatus @default(active)
  assignedTerminal      String?    @map("assigned_terminal")
  allowPosAccess        Boolean    @default(true) @map("allow_pos_access")
  allowBackOfficeAccess Boolean    @default(true) @map("allow_back_office_access")
  requirePasswordChange Boolean    @default(false) @map("require_password_change")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  branch                Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  company               Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, branchId])
  @@map("company_users")
}

model Role {
  id          String           @id @default(cuid())
  companyId   String?          @map("company_id")
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  templateKey RoleTemplate?    @map("template_key")
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  module      String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String  @map("user_id")
  roleId    String  @map("role_id")
  companyId String? @map("company_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([companyId])
  @@map("user_roles")
}

model Product {
  id              String       @id @default(cuid())
  companyId       String       @map("company_id")
  branchId        String       @map("branch_id")
  categoryId      String?      @map("category_id")
  supplierId      String?      @map("supplier_id")
  brandId         String?      @map("brand_id")
  sku             String?
  barcode         String?
  productCode     String?      @map("product_code")
  nameLo          String       @map("name_lo")
  nameEn          String?      @map("name_en")
  description     String?
  tags            Json?
  imageUrl        String?      @map("image_url")
  productType     ProductType  @default(standard) @map("product_type")
  baseUnitId      String?      @map("base_unit_id")
  stockDisplayMode StockDisplayMode @default(base_unit_only) @map("stock_display_mode")
  costPriceLak    Decimal      @default(0) @map("cost_price_lak") @db.Decimal(18, 2)
  sellingPriceLak Decimal      @default(0) @map("selling_price_lak") @db.Decimal(18, 2)
  minStock        Decimal      @default(0) @map("min_stock") @db.Decimal(18, 3)
  status          ProductStatus @default(active)
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch       @relation(fields: [branchId], references: [id])
  category        Category?    @relation(fields: [categoryId], references: [id])
  supplier        Supplier?    @relation(fields: [supplierId], references: [id])
  brand           Brand?       @relation(fields: [brandId], references: [id])
  units           ProductUnit[]
  images          ProductImage[]
  balances        InventoryBalance[]
  inventoryLots   InventoryLot[]
  movements       StockMovement[]
  adjustments     StockAdjustment[]
  purchaseItems   PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  saleItems       SaleItem[]
  priceHistory    ProductPriceHistory[]
  barcodeHistory  ProductBarcodeHistory[]
  favoriteBy      FavoriteProduct[]
  promotionProducts PromotionProduct[]

  @@unique([companyId, sku])
  @@unique([companyId, productCode])
  @@index([companyId, branchId])
  @@index([companyId, barcode])
  @@index([companyId, nameLo])
  @@index([companyId, nameEn])
  @@map("products")
}

model ProductUnit {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  unitName        String   @map("unit_name")
  conversionQty   Decimal  @map("conversion_qty") @db.Decimal(18, 3)
  barcode         String?
  costPriceLak    Decimal? @map("cost_price_lak") @db.Decimal(18, 2)
  sellingPriceLak Decimal  @map("selling_price_lak") @db.Decimal(18, 2)
  pricingMode     UnitPricingMode @default(manual) @map("pricing_mode")
  markupPercent   Decimal? @map("markup_percent") @db.Decimal(8, 3)
  addAmountLak    Decimal? @map("add_amount_lak") @db.Decimal(18, 2)
  roundingLak     Int      @default(0) @map("rounding_lak")
  imageUrl        String?  @map("image_url")
  isBaseUnit      Boolean  @default(false) @map("is_base_unit")
  isDefaultSaleUnit Boolean @default(false) @map("is_default_sale_unit")
  isPurchaseUnit  Boolean  @default(false) @map("is_purchase_unit")
  allowManualUnitSelect Boolean @default(true) @map("allow_manual_unit_select")
  status          UnitStatus @default(active)
  sortOrder       Int      @default(0) @map("sort_order")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  saleItems       SaleItem[]

  @@index([barcode])
  @@map("product_units")
}

model Category {
  id        String     @id @default(cuid())
  companyId String     @map("company_id")
  branchId  String     @map("branch_id")
  nameLo    String     @map("name_lo")
  nameEn    String?    @map("name_en")
  parentId  String?    @map("parent_id")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch     @relation(fields: [branchId], references: [id])
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  promotionCategories PromotionCategory[]

  @@index([companyId])
  @@index([companyId, branchId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  name      String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([companyId, name])
  @@map("brands")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  imageUrl  String  @map("image_url")
  isPrimary Boolean @default(false) @map("is_primary")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model InventoryBalance {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  warehouseId String    @map("warehouse_id")
  productId   String    @map("product_id")
  quantity    Decimal   @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime  @updatedAt @map("updated_at")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([companyId])
  @@map("inventory_balances")
}

model InventoryLot {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  warehouseId String    @map("warehouse_id")
  productId   String    @map("product_id")
  lotNumber   String?   @map("lot_number")
  expiryDate  DateTime? @map("expiry_date")
  quantity    Decimal   @default(0) @db.Decimal(18, 3)
  receivedAt  DateTime? @map("received_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@index([warehouseId, productId])
  @@index([expiryDate])
  @@map("inventory_lots")
}

model StockMovement {
  id            String            @id @default(cuid())
  companyId     String            @map("company_id")
  warehouseId   String            @map("warehouse_id")
  productId     String            @map("product_id")
  unitId        String?           @map("unit_id")
  lotNumber     String?           @map("lot_number")
  expiryDate    DateTime?         @map("expiry_date")
  sourceWarehouseId      String?  @map("source_warehouse_id")
  destinationWarehouseId String?  @map("destination_warehouse_id")
  movementType  StockMovementType @map("movement_type")
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  quantity      Decimal           @db.Decimal(18, 3)
  beforeQty     Decimal           @map("before_qty") @db.Decimal(18, 3)
  afterQty      Decimal           @map("after_qty") @db.Decimal(18, 3)
  note          String?
  createdBy     String?           @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  unit          ProductUnit?      @relation(fields: [unitId], references: [id])
  sourceWarehouse      Warehouse? @relation("StockMovementSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse? @relation("StockMovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  @@index([companyId, productId])
  @@index([warehouseId, productId])
  @@index([companyId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockAdjustment {
  id             String    @id @default(cuid())
  companyId      String    @map("company_id")
  warehouseId    String    @map("warehouse_id")
  productId      String    @map("product_id")
  adjustmentType String    @map("adjustment_type")
  quantity       Decimal   @db.Decimal(18, 3)
  reason         String?
  approvedBy     String?   @map("approved_by")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  product        Product   @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@map("stock_adjustments")
}

model StockTransfer {
  id              String              @id @default(cuid())
  companyId       String              @map("company_id")
  fromWarehouseId String              @map("from_warehouse_id")
  toWarehouseId   String              @map("to_warehouse_id")
  transferNo      String              @map("transfer_no")
  status          StockTransferStatus @default(draft)
  note            String?
  createdBy       String?             @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  fromWarehouse   Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  items           StockTransferItem[]

  @@unique([companyId, transferNo])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String       @map("transfer_id")
  productId  String       @map("product_id")
  quantity   Decimal      @db.Decimal(18, 3)
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model Supplier {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  branchId     String    @map("branch_id")
  supplierCode String?   @map("supplier_code")
  name         String
  companyName  String?   @map("company_name")
  contactPerson String?  @map("contact_person")
  phone        String?
  email        String?
  address      String?
  taxNumber    String?   @map("tax_number")
  note         String?
  creditLimit  Decimal   @default(0) @map("credit_limit") @db.Decimal(18, 2)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(18, 2)
  outstandingBalance Decimal @default(0) @map("outstanding_balance") @db.Decimal(18, 2)
  creditTerms  String?   @map("credit_terms")
  averageDeliveryDays Decimal? @map("average_delivery_days") @db.Decimal(8, 2)
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch    @relation(fields: [branchId], references: [id])
  products     Product[]
  purchases    Purchase[]
  payables     SupplierPayable[]

  @@unique([companyId, supplierCode])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@map("suppliers")
}

model SupplierPayable {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  supplierId    String        @map("supplier_id")
  purchaseId    String?       @map("purchase_id")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(18, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 2)
