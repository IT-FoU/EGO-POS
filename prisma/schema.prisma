model Approval {
  id                String         @id @default(cuid())
  companyId         String         @map("company_id")
  branchId          String?        @map("branch_id")
  module            String
  action            String?
  requestType       String?        @map("request_type")
  referenceId       String         @map("reference_id")
  requestBy         String         @map("request_by")
  requestedByRole   String?        @map("requested_by_role")
  approvedBy        String?        @map("approved_by")
  status            ApprovalStatus @default(pending)
  oldValue          Json?          @map("old_value")
  newValue          Json?          @map("new_value")
  amount            Decimal?       @db.Decimal(18, 2)
  reason            String?
  note              String?
  decisionNote      String?        @map("decision_note")
  relatedEntityType String?        @map("related_entity_type")
  relatedEntityId   String?        @map("related_entity_id")
  decidedAt         DateTime?      @map("decided_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, branchId, status])
  @@map("approvals")
}

model ApprovalRule {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  ruleKey          String   @map("rule_key")
  isEnabled        Boolean  @default(true) @map("is_enabled")
  approverRole     String   @default("owner") @map("approver_role")
  thresholdLak     Decimal? @map("threshold_lak") @db.Decimal(18, 2)
  thresholdPercent Decimal? @map("threshold_percent") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ruleKey])
  @@index([companyId, isEnabled])
  @@map("approval_rules")
}

model Plan {
  id              String   @id @default(cuid())
  planName        String   @unique @map("plan_name")
